# Local development environment for services/api.
#
# Copy this file to .env and fill in real (still local-only, throwaway)
# values — .env itself is gitignored and must NEVER be committed. These
# placeholder values are not secrets worth protecting on their own (they
# only ever expose a developer's own laptop's local Docker containers), but
# must never be reused for real DigitalOcean-provisioned instances.
#
# See docker-compose.yml and services/api/README.md for the local dev
# workflow, and docs/DECISION_LOG.md, "Database setup: shared platform
# foundation + Audit on real Postgres", for why there are two separate
# Postgres connection strings below.

# --- Postgres bootstrap (docker-compose.yml's postgres service) ---
# This is the ADMIN role docker-compose creates the database with — used
# only to run schema migrations at startup (MIGRATIONS_DATABASE_URL below).
# The running application never connects as this role.
POSTGRES_USER=ascend_admin
POSTGRES_PASSWORD=changeme-local-admin
POSTGRES_DB=ascend

# Elevated connection used ONLY at startup to run migrations (CREATE TABLE,
# CREATE ROLE, REVOKE). Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# above.
MIGRATIONS_DATABASE_URL=postgres://ascend_admin:changeme-local-admin@localhost:5432/ascend?sslmode=disable

# The password platform.ProvisionAppRolePassword sets, at startup, for the
# least-privilege ascend_app role every capability's runtime connection
# actually uses (see internal/platform/migrations/0001_audit_events.up.sql).
ASCEND_APP_DB_PASSWORD=changeme-local-app

# The application's own day-to-day connection string — least-privilege
# ascend_app role, not the admin role above. Must use the same password as
# ASCEND_APP_DB_PASSWORD.
DATABASE_URL=postgres://ascend_app:changeme-local-app@localhost:5432/ascend?sslmode=disable

# --- Redis (docker-compose.yml's redis service) ---
# Scoped to purely ephemeral state (challenge nonces, future rate-limiting
# counters) — never a source of truth for anything durable/exportable.
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3-compatible object storage (docker-compose.yml's minio service) ---
# Local dev target is MinIO; the same S3_* variables point at DigitalOcean
# Spaces (or real S3) in a real deployment — only these values change, the
# client code (internal/platform/objectstore.go) does not.
MINIO_ROOT_USER=ascend_minio
MINIO_ROOT_PASSWORD=changeme-local-minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ascend-local
S3_ACCESS_KEY=ascend_minio
S3_SECRET_KEY=changeme-local-minio
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
