# Copy to .env (gitignored) for local dev. Expo CLI loads .env
# automatically on every `expo start`/`npm start`
# (https://docs.expo.dev/guides/environment-variables/) -- no shell
# session state to set or lose across restarts, unlike `$env:X = "..."`.

# Base URL for services/api (`cd services/api && go run .`). Which value
# is correct depends entirely on what's running the app:
#   - Android emulator:      http://10.0.2.2:8080   (fixed alias to host's own localhost)
#   - Physical device (any): http://<your-PC's-LAN-IP>:8080  (e.g. http://192.168.1.23:8080 -- find via `ipconfig`; phone and PC must be on the same network)
#   - Web (`expo start --web`), same machine: http://localhost:8080 (the default in httpClient.ts if this var is unset at all)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
